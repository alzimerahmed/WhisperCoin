<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme -->
    <style name="Theme.WhisperCoinCompose" parent="Theme.AppCompat.Light.NoActionBar" />
    
    <!-- Splash Screen theme for light mode -->
    <style name="Theme.WhisperCoin.SplashScreen" parent="Theme.SplashScreen">
        
        <!-- Set splash screen duration (Android 12+) -->
        <item name="windowSplashScreenAnimationDuration">1000</item>
        
        <!-- Set the theme to use after splash screen -->
        <item name="postSplashScreenTheme">@style/Theme.WhisperCoinCompose</item>
    </style>

    <style name="Theme.WhisperCoin.SplashScreen.Original" parent="Theme.WhisperCoin.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

    <style name="Theme.WhisperCoin.SplashScreen.Anarchy" parent="Theme.WhisperCoin.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

    <style name="Theme.WhisperCoin.SplashScreen.Zenith" parent="Theme.WhisperCoin.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

    <style name="Theme.WhisperCoin.SplashScreen.Monochrome" parent="Theme.WhisperCoin.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

    <style name="Theme.WhisperCoin.SplashScreen.Comic" parent="Theme.WhisperCoin.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
